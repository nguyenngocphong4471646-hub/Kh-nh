--// Logic Auto Bay vào / Bay ra Cửa Hang Núi Lửa (Auto 2,5T)
task.spawn(function()
    while true do
        if Config.AutoVolcano then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local insideCave, outsideCave = nil, nil
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if obj:IsA("BasePart") or obj:IsA("Model") then
                            local success, nameLower = pcall(function() return string.lower(obj.Name) end)
                            if success and nameLower then
                                if string.find(nameLower, "volcano") or string.find(nameLower, "nuilua") or string.find(nameLower, "cave") or string.find(nameLower, "cuahang") then
                                    local p = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                                    if p then
                                        if string.find(nameLower, "in") or string.find(nameLower, "inside") then
                                            insideCave = p
                                        elseif string.find(nameLower, "out") or string.find(nameLower, "outside") or string.find(nameLower, "door") then
                                            outsideCave = p
                                        end
                                    end
                                end
                            end
                        end
                    end
                    
                    if insideCave and outsideCave then
                        hrp.CFrame = insideCave.CFrame + Vector3.new(0, 3, 0)
                        task.wait(1.5)
                        hrp.CFrame = outsideCave.CFrame + Vector3.new(0, 3, 0)
                        task.wait(1.5)
                    else
                        for _, obj in ipairs(Workspace:GetDescendants()) do
                            if obj.Name:lower():find("volcano") and obj:IsA("BasePart") then
                                hrp.CFrame = obj.CFrame + Vector3.new(0, 5, 0)
                                task.wait(2)
                                break
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.5)
    end
end)

--// Logic Teleport đến quả trứng XA NHẤT khớp tên
teleBtn.MouseButton1Click:Connect(function()
    local searchName = string.lower(textBox.Text)
    if searchName == "" then 
        warn("Vui lòng nhập tên trứng vào ô!")
        return 
    end
    
    local foundTarget = nil
    local longestDistance = -1
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if not hrp then return end
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local success, nameLower = pcall(function() return string.lower(obj.Name) end)
            if success and nameLower and string.find(nameLower, searchName) then
                local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                if targetPart then
                    local dist = (targetPart.Position - hrp.Position).Magnitude
                    if dist > longestDistance then
                        longestDistance = dist
                        foundTarget = targetPart
                    end
                end
            end
        end
    end
    
    if foundTarget then
        hrp.CFrame = foundTarget.CFrame + Vector3.new(0, 3, 0)
        print("Đã tele đến trứng xa nhất: " .. tostring(foundTarget.Parent.Name) .. " | Khoảng cách: " .. math.floor(longestDistance) .. "m")
    else
        warn("Không tìm thấy trứng khớp tên!")
    end
end)

