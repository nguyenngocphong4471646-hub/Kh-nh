local activeESPs = {}

local function removeESP(object, tag)
    if object and object:FindFirstChild(tag) then
        object[tag]:Destroy()
    end
end

local function clearAllESP(tag)
    for obj, _ in pairs(activeESPs) do
        if obj then
            removeESP(obj, tag)
        end
    end
end

