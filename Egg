--// Hàm tạo nhãn ESP chung an toàn
local function createCustomESP(object, color, customText, tagName)
    if not object:FindFirstChild(tagName) then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = tagName
        billboard.Size = UDim2.new(0, 160, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = object

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = customText
        textLabel.TextColor3 = color
        textLabel.TextScaled = true
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.Parent = billboard
    else
        local billboard = object:FindFirstChild(tagName)
        if billboard and billboard:FindFirstChild("TextLabel") then
            billboard.TextLabel.Text = customText
        end
    end
end

