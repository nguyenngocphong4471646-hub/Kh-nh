end)

--// 3. Chức năng ESP Trứng
local function setupEggESP()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local success, nameLower = pcall(function() return string.lower(obj.Name) end)
            if success and nameLower then
                local isEgg = string.find(nameLower, "egg") or string.find(nameLower, "trứng")
                if isEgg then
                    local isSecret = string.find(nameLower, "secret")
                    if isSecret then
                        if Config.ESPEggSecret then
                            activeESPs[obj] = true
                            createCustomESP(obj, Color3.fromRGB(255, 0, 0), "🔒 [SECRET] " .. obj.Name, "SecretEggESP")
                        else
                            removeESP(obj, "SecretEggESP")
                        end
                        removeESP(obj, "NormalEggESP")
                    else
                        if Config.ESPEggNormal then
                            activeESPs[obj] = true
                            createCustomESP(obj, Color3.fromRGB(255, 255, 255), "🥚 [Thường] " .. obj.Name, "NormalEggESP")
                        else
                            removeESP(obj, "NormalEggESP")
                        end
                        removeESP(obj, "SecretEggESP")
                    end
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        pcall(setupEggESP)
        task.wait(1.5)
    end
end)

