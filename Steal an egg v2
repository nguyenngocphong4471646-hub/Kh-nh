local function CreateToggleButton(configKey, name, posY, callback)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(0.92, 0, 0, 28)
    Button.Position = UDim2.new(0.04, 0, 0, posY)
    Button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.TextSize = 11
    Button.Font = Enum.Font.Code
    Button.Parent = MainFrame
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Button
    
    local currentState = getgenv().Config[configKey] or false
    Button.BackgroundColor3 = currentState and Color3.fromRGB(30, 170, 70) or Color3.fromRGB(35, 35, 35)
    Button.Text = name .. (currentState and " [ON]" or " [OFF]")
    callback(currentState)

    Button.MouseButton1Click:Connect(function()
        currentState = not currentState
        getgenv().Config[configKey] = currentState
        SaveConfig()
        
        Button.BackgroundColor3 = currentState and Color3.fromRGB(30, 170, 70) or Color3.fromRGB(35, 35, 35)
        Button.Text = name .. (currentState and " [ON]" or " [OFF]")
        callback(currentState)
    end)
    return Button
end

