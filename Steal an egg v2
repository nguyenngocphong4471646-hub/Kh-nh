local function LoadConfig()
    local success, result = pcall(function()
        if writefile and readfile and isfile and isfile(CONFIG_FILE) then
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end
    end)
    if success and type(result) == "table" then
        for k, v in pairs(defaultValues) do
            getgenv().Config[k] = result[k] ~= nil and result[k] or v
        end
        if type(getgenv().Config.HomePosition) == "table" then
            local pos = getgenv().Config.HomePosition
            getgenv().Config.HomePosition = Vector3.new(pos.X or 0, pos.Y or 10, pos.Z or 0)
        end
    else
        for k, v in pairs(defaultValues) do
            getgenv().Config[k] = v
        end
        getgenv().Config.HomePosition = Vector3.new(0, 10, 0)
    end
end

local function SaveConfig()
    pcall(function()
        if writefile then
            local dataToSave = {}
            for k, v in pairs(getgenv().Config) do
                if typeof(v) == "Vector3" then
                    dataToSave[k] = {X = v.X, Y = v.Y, Z = v.Z}
                else
                    dataToSave[k] = v
                end
            end
            writefile(CONFIG_FILE, HttpService:JSONEncode(dataToSave))
        end
    end)
end

