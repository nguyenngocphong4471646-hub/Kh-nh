-- 3. ESP Tối ưu (Quét thưa hơn và giới hạn phạm vi để hoàn toàn không bị khựng hình)
task.spawn(function()
    while task.wait(1.5) do -- Tăng thời gian chờ lên 1.5s để giải phóng CPU
        pcall(function()
            if getgenv().Config.ESPCOsmicEggs then
                for _, obj in pairs(Workspace:GetChildren()) do
                    if obj:IsA("Model") then
                        local nameLower = obj.Name:lower()
                        if string.find(nameLower, "egg") or string.find(nameLower, "cosmic") or string.find(nameLower, "secret") or string.find(nameLower, "mythic") or string.find(nameLower, "event") or string.find(nameLower, "chest") then
                            if not obj:FindFirstChild("CosmicESPBox") then
                                local highlight = Instance.new("Highlight")
                                highlight.Name = "CosmicESPBox"
                                highlight.Adornee = obj
                                highlight.FillColor = Color3.fromRGB(170, 0, 255)
                                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                                highlight.Parent = obj
                            end
                        end
                    end
                end
            else
                for _, obj in pairs(Workspace:GetChildren()) do
                    if obj:IsA("Model") and obj:FindFirstChild("CosmicESPBox") then
                        obj.CosmicESPBox:Destroy()
                    end
                end
            end
            
            if getgenv().Config.ESPPlayers then
                for _, player in pairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character then
                        if not player.Character:FindFirstChild("PlayerESPBox") then
                            local highlight = Instance.new("Highlight")
                            highlight.Name = "PlayerESPBox"
                            highlight.Adornee = player.Character
                            highlight.FillColor = Color3.fromRGB(0, 191, 255)
                            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                            highlight.Parent = player.Character
                        end
                    end
                end
            else
                for _, player in pairs(Players:GetPlayers()) do
                    if player.Character and player.Character:FindFirstChild("PlayerESPBox") then
                        player.Character.PlayerESPBox:Destroy()
                    end
                end
            end
        end)
    end
end)

