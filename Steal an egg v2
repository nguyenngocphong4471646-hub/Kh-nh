-- 1. Mô-đun Fly mượt mà
local flyBodyVelocity, flyBodyGyro
RunService.RenderStepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
        local rootPart = char.HumanoidRootPart
        local humanoid = char.Humanoid
        
        if getgenv().Config.AutoFlyHome then
            if not rootPart:FindFirstChild("CosmicFlyVelocity") then
                flyBodyVelocity = Instance.new("BodyVelocity")
                flyBodyVelocity.Name = "CosmicFlyVelocity"
                flyBodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
                flyBodyVelocity.Parent = rootPart
                
                flyBodyGyro = Instance.new("BodyGyro")
                flyBodyGyro.Name = "CosmicFlyGyro"
                flyBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                flyBodyGyro.CFrame = rootPart.CFrame
                flyBodyGyro.Parent = rootPart
            end
            
            humanoid.PlatformStand = true
            local targetPos = getgenv().Config.HomePosition
            local direction = (targetPos - rootPart.Position)
            local distance = direction.Magnitude
            
            if distance > 5 then
                flyBodyVelocity.Velocity = direction.Unit * getgenv().Config.FlySpeed
                flyBodyGyro.CFrame = CFrame.new(rootPart.Position, targetPos)
            else
                flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
                humanoid.PlatformStand = false
                if flyBodyVelocity then flyBodyVelocity:Destroy() end
                if flyBodyGyro then flyBodyGyro:Destroy() end
                getgenv().Config.AutoFlyHome = false
            end
        else
            if rootPart:FindFirstChild("CosmicFlyVelocity") then rootPart.CosmicFlyVelocity:Destroy() end
            if rootPart:FindFirstChild("CosmicFlyGyro") then rootPart.CosmicFlyGyro:Destroy() end
            humanoid.PlatformStand = false
        end
    end)
end)

