-- Helper: Tạo nhóm danh mục (Section)
local function CreateSection(titleText)
    local Section = Instance.new("Frame", ScrollFrame)
    Section.Size = UDim2.new(1, -8, 0, 0)
    Section.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    
    local SecCorner = Instance.new("UICorner", Section)
    SecCorner.CornerRadius = UDim.new(0, 6)

    local SecTitle = Instance.new("TextLabel", Section)
    SecTitle.Size = UDim2.new(1, -10, 0, 22)
    SecTitle.Position = UDim2.new(0, 8, 0, 2)
    SecTitle.BackgroundTransparency = 1
    SecTitle.Text = titleText
    SecTitle.TextColor3 = Color3.fromRGB(180, 180, 180)
    SecTitle.Font = Enum.Font.SourceSansBold
    SecTitle.TextSize = 11
    SecTitle.TextXAlignment = Enum.TextXAlignment.Left

    local Container = Instance.new("Frame", Section)
    Container.Size = UDim2.new(1, -12, 0, 0)
    Container.Position = UDim2.new(0, 6, 0, 24)
    Container.BackgroundTransparency = 1

    local Grid = Instance.new("UIGridLayout", Container)
    Grid.CellSize = UDim2.new(0, 165, 0, 26)
    Grid.CellPadding = UDim2.new(0, 8, 0, 6)

    Grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Container.Size = UDim2.new(1, -12, 0, Grid.AbsoluteContentSize.Y)
        Section.Size = UDim2.new(1, -8, 0, Grid.AbsoluteContentSize.Y + 30)
    end)

    return Container
end

-- Helper: Tạo Nút Toggle trong Section
local function CreateToggle(parent, name, callback)
    local btn = Instance.new("TextButton", parent)
    btn.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 10
    btn.Text = name .. ": [OFF]"
    
    local corner = Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(0, 4)

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            btn.BackgroundColor3 = Color3.fromRGB(40, 140, 60)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Text = name .. ": [ON]"
        else
            btn.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            btn.Text = name .. ": [OFF]"
        end
        pcall(callback, state)
    end)
    return btn
end

