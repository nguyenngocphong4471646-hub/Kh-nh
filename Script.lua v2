-- Tracers (Tia ESP)
local Lines = {}
local function ClearLines()
    for _, line in pairs(Lines) do line:Remove() end
    Lines = {}
end

CreateToggle(ESPSec, "Tia ESP", function(enabled)
    _G.Tracers = enabled
    if not enabled then ClearLines() end
end)

RunService.RenderStepped:Connect(function()
    if not _G.Tracers or not Drawing then ClearLines() return end
    ClearLines()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local pos, onScreen = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
            if onScreen then
                local line = Drawing.new("Line")
                line.Visible = true
                line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                line.To = Vector2.new(pos.X, pos.Y)
                line.Color = Color3.fromRGB(0, 255, 0)
                line.Thickness = 1.2
                table.insert(Lines, line)
            end
        end
    end
end)

-- Group 3: Chiến đấu (Combat)
local CombatSec = CreateSection("3. COMBAT & BÁ ĐẠO")

CreateToggle(CombatSec, "Aimbot Head", function(enabled)
    _G.Aimbot = enabled
    task.spawn(function()
        while _G.Aimbot do
            local closestPlayer = nil
            local shortestDistance = math.huge
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
                    local pos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            closestPlayer = player
                        end
                    end
                end
            end
            if closestPlayer and closestPlayer.Character and closestPlayer.Character:FindFirstChild("Head") then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestPlayer.Character.Head.Position)
            end
            task.wait()
        end
    end)
end)

CreateToggle(CombatSec, "Gom Nguoi", function(enabled)
    _G.BringAll = enabled
    task.spawn(function()
        while _G.BringAll do
            pcall(function()
                local myChar = LocalPlayer.Character
                if myChar and myChar:FindFirstChild("HumanoidRootPart") then
