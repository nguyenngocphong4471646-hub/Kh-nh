end)

-- Hàm bay về nhà (Có kiểm tra trạng thái Bật/Tắt liên tục để ngắt ngay lập tức khi người dùng tắt)
local function flyHomeFast()
    if isFlyingHome then return end
    isFlyingHome = true

    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        isFlyingHome = false
        return
    end

    local rootPart = character.HumanoidRootPart
    local homePosition = Vector3.new(0, 10, 0) -- THAY ĐỔI TỌA ĐỘ NHÀ CỦA BẠN TẠI ĐÂY

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.PlatformStand = true end

    while (rootPart.Position - homePosition).Magnitude > 5 do
        -- Nếu người dùng bấm tắt tính năng bay giữa chừng, vòng lặp sẽ dừng ngay lập tức
        if not autoTeleportHomeEnabled or not character or not rootPart.Parent then 
            break 
        end
        
        local currentPos = rootPart.Position
        local direction = (homePosition - currentPos).Unit
        local distanceThisFrame = flySpeed * RunService.RenderStepped:Wait()
        
        if (homePosition - currentPos).Magnitude < distanceThisFrame then
            rootPart.CFrame = CFrame.new(homePosition)
            break
        else
            rootPart.CFrame = rootPart.CFrame + (direction * distanceThisFrame)
        end
    end

    if humanoid then humanoid.PlatformStand = false end
    isFlyingHome = false
end

