-- 1. Mô-đun Auto Fly Home: Bay trục X rồi Z (Tốc độ chuẩn 210)
RunService.Heartbeat:Connect(function(dt)
    if getgenv().Config.AutoFlyHome then
        pcall(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local rootPart = char.HumanoidRootPart
            local humanoid = char:FindFirstChild("Humanoid")
            
            local targetPos = getgenv().Config.HomePosition
            local currentPos = rootPart.Position
            
            local step = 210 * dt -- Tốc độ chính xác 210 studs/s
            
            humanoid.PlatformStand = true
            
            -- Giai đoạn 1: Trục X
            if math.abs(currentPos.X - targetPos.X) > 3 then
                local dirX = (targetPos.X > currentPos.X) and 1 or -1
                local newX = currentPos.X + (dirX * math.min(step, math.abs(currentPos.X - targetPos.X)))
                local lookAtTarget = Vector3.new(targetPos.X, currentPos.Y, currentPos.Z)
                
                local raycastParams = RaycastParams.new()
                raycastParams.FilterDescendantsInstances = {char}
                raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                local raycastResult = Workspace:Raycast(Vector3.new(newX, currentPos.Y + 50, currentPos.Z), Vector3.new(0, -100, 0), raycastParams)
                local groundY = raycastResult and (raycastResult.Position.Y + 3) or currentPos.Y
                
                rootPart.CFrame = CFrame.new(Vector3.new(newX, groundY, currentPos.Z), lookAtTarget)
                
            -- Giai đoạn 2: Trục Z
            elseif math.abs(currentPos.Z - targetPos.Z) > 3 then
                local dirZ = (targetPos.Z > currentPos.Z) and 1 or -1
                local newZ = currentPos.Z + (dirZ * math.min(step, math.abs(currentPos.Z - targetPos.Z)))
                local lookAtTarget = Vector3.new(targetPos.X, currentPos.Y, targetPos.Z)
                
                local raycastParams = RaycastParams.new()
                raycastParams.FilterDescendantsInstances = {char}
                raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                local raycastResult = Workspace:Raycast(Vector3.new(targetPos.X, currentPos.Y + 50, newZ), Vector3.new(0, -100, 0), raycastParams)
                local groundY = raycastResult and (raycastResult.Position.Y + 3) or currentPos.Y
                
                rootPart.CFrame = CFrame.new(Vector3.new(targetPos.X, groundY, newZ), lookAtTarget)
                
            -- Giai đoạn 3: Hoàn tất
            else
                local raycastParams = RaycastParams.new()
                raycastParams.FilterDescendantsInstances = {char}
                raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                local raycastResult = Workspace:Raycast(targetPos + Vector3.new(0, 50, 0), Vector3.new(0, -100, 0), raycastParams)
                
                if raycastResult then
                    rootPart.CFrame = CFrame.new(raycastResult.Position + Vector3.new(0, 3, 0))
                else
                    rootPart.CFrame = CFrame.new(targetPos)
                end
                
                humanoid.PlatformStand = false
                getgenv().Config.AutoFlyHome = false
            end
        end)
    end
end)

