        pcall(function()
            if getgenv().Config.ESPCOsmicEggs then
                for _, obj in pairs(Workspace:GetChildren()) do
                    if obj:IsA("Model") and (string.find(obj.Name:lower(), "cosmic") or string.find(obj.Name:lower(), "secret") or string.find(obj.Name:lower(), "mythic")) then
                        if not obj:FindFirstChild("CosmicESP") then
                            local highlight = Instance.new("Highlight")
                            highlight.Name = "CosmicESP"
                            highlight.Adornee = obj
                            highlight.FillColor = Color3.fromRGB(138, 43, 226)
                            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                            highlight.Parent = obj
                        end
                    end
                end
            else
                for _, obj in pairs(Workspace:GetChildren()) do
                    if obj:IsA("Model") and obj:FindFirstChild("CosmicESP") then
                        obj.CosmicESP:Destroy()
                    end
                end
            end
            
            if getgenv().Config.ESPPlayers then
                for _, player in pairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character then
                        if not player.Character:FindFirstChild("PlayerESP") then
                            local highlight = Instance.new("Highlight")
                            highlight.Name = "PlayerESP"
                            highlight.Adornee = player.Character
                            highlight.FillColor = Color3.fromRGB(0, 191, 255)
                            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                            highlight.Parent = player.Character
                        end
                    end
                end
            else
                for _, player in pairs(Players:GetPlayers()) do
                    if player.Character and player.Character:FindFirstChild("PlayerESP") then
                        player.Character.PlayerESP:Destroy()
                    end
                end
            end
        end)
    end
end)

