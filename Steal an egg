-- Hàm thông minh: Chỉ xóa trọng lượng của riêng quả trứng/vật phẩm đang cầm, KHÔNG làm ảnh hưởng đến chân nhân vật
local function RemoveEggWeightOnly()
    pcall(function()
        if character then
            for _, item in ipairs(character:GetDescendants()) do
                -- Chỉ nhắm vào các phần không phải là bộ phận cơ thể chính của nhân vật (như tool, vật phẩm cầm trên tay)
                if item:IsA("BasePart") and item.Name ~= "HumanoidRootPart" and item.Name ~= "Head" and item.Name ~= "Torso" and item.Name ~= "UpperTorso" and item.Name ~= "LowerTorso" then
                    item.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    item.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
                end
            end
        end
    end)
end

-- 1. Tính năng Fly Về Điểm (Speed 210)
local savedPosition = nil
local isFlyingToMark = false

FlyToMarkBtn.MouseButton1Click:Connect(function()
    if isFlyingToMark then
        isFlyingToMark = false
        FlyToMarkBtn.Text = "Fly Về Điểm (Speed 210)"
        FlyToMarkBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        return
    end

    if not savedPosition then
        FlyToMarkBtn.Text = "Chưa Có Điểm Lưu!"
        task.wait(1.5)
        FlyToMarkBtn.Text = "Fly Về Điểm (Speed 210)"
        return
    end
    
    isFlyingToMark = true
    FlyToMarkBtn.Text = "Đang Bay Về (Bấm để Tắt)..."
    FlyToMarkBtn.BackgroundColor3 = Color3.fromRGB(170, 110, 0)

    task.spawn(function()
        pcall(function()
            local targetPos = savedPosition.Position
            while (rootPart.Position - targetPos).Magnitude > 5 and isFlyingToMark do
                RemoveEggWeightOnly()
                
                local direction = (targetPos - rootPart.Position).Unit
                rootPart.CFrame = rootPart.CFrame + (direction * math.min(210 * task.wait(), (targetPos - rootPart.Position).Magnitude))
            end
            
            -- Khi bay đến nơi hoặc khi tắt ngang chừng: Trả lại trạng thái vật lý bình thường cho nhân vật
            if rootPart then
                rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
            if savedPosition and not isFlyingToMark == false then
                -- Nếu đến đích hoàn toàn thì dịch chuyển chuẩn xác vào vị trí cũ
                rootPart.CFrame = savedPosition 
            end
        end)
        
        isFlyingToMark = false
        FlyToMarkBtn.Text = "Fly Về Điểm (Speed 210)"
        FlyToMarkBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end)
end)

-- 2. Tính năng Bay Tự Do (Speed 210)
local flying = false
local bv, bg

FlyBtn.MouseButton1Click:Connect(function()
    flying = not flying
    if flying then
        FlyBtn.Text = "Bay Tự Do: ON"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = rootPart
        
        bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.CFrame = rootPart.CFrame
        bg.Parent = rootPart
        
        task.spawn(function()
            local cam = workspace.CurrentCamera
            while flying do
                RemoveEggWeightOnly()
                local moveDir = Vector3.new()
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.W) then
                    moveDir = moveDir + cam.CFrame.LookVector
                end
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.S) then
                    moveDir = moveDir - cam.CFrame.LookVector
                end
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.A) then
                    moveDir = moveDir - cam.CFrame.RightVector
                end
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.D) then
                    moveDir = moveDir + cam.CFrame.RightVector
                end
                
                bv.Velocity = moveDir * 210
                bg.CFrame = cam.CFrame
                task.wait()
            end
        end)
    else
        FlyBtn.Text = "Bay Tự Do (Speed: 210): OFF"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
        if rootPart then rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
    end
end)

